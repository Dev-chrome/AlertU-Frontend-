{
  "expo": {
    "name": "AlertU",
    "slug": "AlertU",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AlertU_ Stay Aware, Stay Ahead.png",
    "scheme": "alertu",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true
    },
    "android": {
      "package": "com.promotex.alertu",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/AlertU Blue Shield Alert Logo.png",
        "backgroundImage": "./assets/images/AlertU Blue Shield Alert Logo.png",
        "monochromeImage": "./assets/images/AlertU Blue Shield Alert Logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F3A",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AlertU to access your photos so you can set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0B1F3A",
          "defaultChannel": "alertu-alerts"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
